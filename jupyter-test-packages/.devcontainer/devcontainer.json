{
  "name": "Jupyter Test - Package Installation",
  "image": "jupyter/base-notebook:python-3.11",
  "features": {
    "./features/src/llm-context": {},
    "./features/src/common-packages": {
      "pythonPackages": "pandas numpy scikit-learn matplotlib seaborn"
    }
  },
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter"
    }
  },
  "postCreateCommand": "python3 --version && echo '=== Installed packages ===' && pip list | grep -E '(pandas|numpy|scikit-learn|matplotlib|seaborn)'",
  "postStartCommand": "start-notebook.sh --ServerApp.token='' --ServerApp.password='' --ip=0.0.0.0 --port=8888 --no-browser"
}
