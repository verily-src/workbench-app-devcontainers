{
  extends: [
    'config:best-practices',
    'schedule:daily',
  ],
  commitMessageSuffix: ' in {{packageFile}}',
  timezone: 'America/New_York',
  draftPR: true,
  ignorePaths: [
    '.github/workflows/**',
  ],
  copier: {
    enabled: false,
  },
  packageRules: [
    {
      matchManagers: ['devcontainer', 'dockerfile', 'docker-compose', 'custom.regex'],
      groupName: 'devcontainer and docker updates',
      commitMessageSuffix: '',
      draftPR: false,
      schedule: ['* 10-13 * * 1'], // Monday 10am-1pm (after release cut)
    },
    {
      matchFileNames: ['features/src/llm-context/templates/**'],
      pinDigests: false,
      rangeStrategy: 'replace',
      matchUpdateTypes: ['major', 'minor', 'patch'],
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      matchDepNames: [
        'cr.sas.com/viya-4-x64_oci_linux_2-docker/sas-analytics-pro', // private repo
        // below are all locally built
        'load-envs',
        'aou-extension-builder',
        'extension-builder',
        'jupyter-extension-builder',
        'wb-secret-receiver',
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '^startupscript/butane/.*\\.sh$',
      ],
      matchStrings: [
        '(?<depName>[\\w./_-]+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
