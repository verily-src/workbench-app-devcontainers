diff --git a/frontend/src/workbenchProxyShim.ts b/frontend/src/workbenchProxyShim.ts
new file mode 100644
index 0000000..0dc5a79
--- /dev/null
+++ b/frontend/src/workbenchProxyShim.ts
@@ -0,0 +1,59 @@
+/**
+ * Verily Workbench reverse-proxy shim.
+ *
+ * Workbench serves apps at https://workbench.verily.com/app/<id>/proxy/8000/
+ * and strips that prefix before forwarding requests to the container. Aevom's
+ * frontend addresses its backend with root-relative URLs ("/api/..."), which
+ * the browser would resolve against workbench.verily.com and so lose the
+ * prefix. This module rewrites same-origin root-relative URLs passed to
+ * fetch() and EventSource so they resolve relative to the directory the page
+ * was loaded from. Behind the proxy that is ".../proxy/8000/"; on a plain
+ * http://localhost:8000 deployment it is "/", so behaviour there is unchanged.
+ *
+ * Imported first in main.tsx so it is installed before any component runs.
+ * Together with Vite's `base: "./"` (set by patch-upstream.sh) this is the
+ * whole of the Workbench-specific change to the frontend.
+ */
+
+// Directory of the current page, e.g. https://host/app/<id>/proxy/8000/.
+// Aevom's only client-side route is a single segment ("/training"), so the
+// directory of the page is always the app root.
+const pageBase = new URL(".", window.location.href);
+
+function rebase(url: string): string {
+  // Root-relative only: "//host/..." and absolute URLs are left alone.
+  if (!url.startsWith("/") || url.startsWith("//")) return url;
+  return new URL(url.slice(1), pageBase).toString();
+}
+
+function rebaseInput(input: RequestInfo | URL): RequestInfo | URL {
+  if (typeof input === "string") return rebase(input);
+  if (input instanceof Request) {
+    // Request.url is already absolute (resolved against the document URL), so
+    // detect a same-origin /api path that escaped the app's prefix.
+    const u = new URL(input.url);
+    if (
+      u.origin === window.location.origin &&
+      u.pathname.startsWith("/api/") &&
+      !u.pathname.startsWith(pageBase.pathname)
+    ) {
+      const rebased = new URL(u.pathname.slice(1) + u.search + u.hash, pageBase);
+      return new Request(rebased.toString(), input);
+    }
+  }
+  return input;
+}
+
+const nativeFetch = window.fetch.bind(window);
+window.fetch = (input: RequestInfo | URL, init?: RequestInit) =>
+  nativeFetch(rebaseInput(input), init);
+
+const NativeEventSource = window.EventSource;
+class RebasedEventSource extends NativeEventSource {
+  constructor(url: string | URL, init?: EventSourceInit) {
+    super(typeof url === "string" ? rebase(url) : url, init);
+  }
+}
+window.EventSource = RebasedEventSource;
+
+export {};
