# Front door of the app (docker-compose.yaml, services opencode-web and assistant-ui): the
# NVIDIA AI Research Assistant at the root, code-server under /ide/.
{
	admin off
	auto_https off
}

:8080 {
	# code-server, the terminal: https://<app>/ide/
	handle_path /ide/* {
		reverse_proxy 127.0.0.1:8443
	}

	# Everything else is the assistant's UI (assistant-ui/server.py). It reaches OpenCode in the
	# sandbox itself and relays its events over a websocket, so nothing here needs to stream.
	handle {
		reverse_proxy 127.0.0.1:9002
	}

	# One line per request on the container's output.
	log {
		output stdout
		format console
	}

	handle_errors {
		@down expression `{http.error.status_code} in [502, 503, 504]`
		handle @down {
			header Content-Type "text/plain; charset=utf-8"
			respond "The assistant is starting. If this stays, open /ide/ and run: agent-sandbox status" 503
		}
	}
}
