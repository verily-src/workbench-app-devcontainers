// Workbench GPU overrides for nf-core/sarek 3.11.0 + NVIDIA Parabricks on Google Batch.
// Loaded via params `custom_config_base` (Workbench mounts the params-file bucket on the Nextflow head node),
// because Workbench-managed runs accept only a profile and a params file, not extra -c configs.
// Run with profile `gpu`. Every Parabricks module in sarek carries label 'process_gpu'.
//
// Region: Workbench's run.config pins Google Batch to the workspace's region, and it is parsed
// after this file, so the location cannot be overridden here. This config uses T4s, one per task:
// they are offered in regions that have no A100 or L4. A run needs one T4 of quota per sample.
process {
  withLabel: process_gpu {
    machineType = 'n1-highmem-16'                        // 16 vCPU, 104 GB RAM
    accelerator = [request: 1, type: 'nvidia-tesla-t4']  // 1x T4 16 GB per task
    cpus        = 16
    memory      = 100.GB
    disk        = 500.GB
    time        = 24.h
  }
  withName: 'PARABRICKS_HAPLOTYPECALLER' {
    // T4 has 16 GB; Parabricks HaplotypeCaller defaults need >=18 GB (Parabricks 4.7.1 installation requirements).
    // Consumed by the Workbench patch in conf/modules/parabricks_haplotypecaller.config of the pinned sarek copy.
    ext.pb_extra_args = '--htvc-low-memory'
  }
  withName: 'PARABRICKS_FQ2BAM' {
    machineType = 'n1-highmem-32'                        // 32 vCPU, 208 GB RAM
    accelerator = [request: 4, type: 'nvidia-tesla-t4']
    cpus        = 32
    memory      = 200.GB
    disk        = 1000.GB
    time        = 24.h
  }
}
google.batch.installGpuDrivers = true
