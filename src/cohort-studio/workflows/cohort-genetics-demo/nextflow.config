params {
    python = 'python3'
    input = null
    variant_dictionary = null
    variant_dictionary_uri = null
    input_uri = null
    output_uri_prefix = 'results'
    output_bucket = null
    output_key = null
    publish_dir = null
    variant_id = 'SYN_VAR_0021'
    cohort_size = null
    source_resource = null
    source_tables = []
    workflow_id = null
    run_id = null
    container = '535002863113.dkr.ecr.us-east-1.amazonaws.com/bench9232/scimilarity@sha256:330aa942ef83d78ec0ab55967303a3dc4401ad58271c93878f5d6229493e5361'
    vendor_archive = "${projectDir}/vendor.zip"
    use_vendored_pydantic = true
    require_s3_output = false
}

process {
    cpus = 1
    memory = '2 GB'
    maxForks = 1
    errorStrategy = 'terminate'
}

docker.enabled = true

profiles {
    local {
        docker.enabled = false
        params.require_s3_output = false
        params.use_vendored_pydantic = false
    }
    healthomics {
        docker.enabled = true
        params.require_s3_output = true
        params.publish_dir = '/mnt/workflow/pubdir'
    }
}
