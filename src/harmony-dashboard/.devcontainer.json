{
  "name": "Harmony Data Harmonization Dashboard",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "workspaceFolder": "/home/jupyter",
  "features": {
    "./harmony-dashboard": {
      "port": "8502"
    }
  },
  "forwardPorts": [8502],
  "portsAttributes": {
    "8502": {
      "label": "Harmony Dashboard",
      "onAutoForward": "ignore"
    }
  },
  "postStartCommand": "/usr/local/bin/start-harmony-dashboard.sh"
}