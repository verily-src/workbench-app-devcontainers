# Example environment for the MDV custom app.
# Copy to `.env` and set real values. `.env` is read by docker-compose for
# variable substitution and is NOT committed.

# PostgreSQL credentials (shared by the app and the mdv_db service).
DB_USER=mdv_user
DB_PASSWORD=mdv_password
DB_NAME=mdv_db

# Flask session signing key — set to a long random value for any real use.
FLASK_SECRET_KEY=change-me-in-dot-env
