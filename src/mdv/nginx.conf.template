# Same-origin reverse proxy for MDV that adds Document-Isolation-Policy so
# SharedArrayBuffer/WASM threads work without depending on the Workbench SDK
# or MDV's own client-side coi-serviceworker fallback (which forces a
# double-load on first visit — costly for Oxford's large datasets). See
# BENCH-9901. `${MDV_API_ROOT}` is substituted by start.sh at container
# startup via envsubst; nginx's own `$variables` below are passed through
# untouched by the explicit substitution allowlist.
worker_processes 1;
pid /tmp/mdv-nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;
    client_body_temp_path /tmp/mdv-nginx-client;
    proxy_temp_path /tmp/mdv-nginx-proxy;
    fastcgi_temp_path /tmp/mdv-nginx-fastcgi;
    uwsgi_temp_path /tmp/mdv-nginx-uwsgi;
    scgi_temp_path /tmp/mdv-nginx-scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        https https;
        http http;
    }

    server {
        listen 5055;
        server_name _;
        absolute_redirect off;
        client_max_body_size 0;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Uncompressed upstream responses, so sub_filter can add the Workspace data browser.
        proxy_set_header Accept-Encoding "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;

        # Workspace data sync log, for checking what was linked or converted (read-only).
        location = /_workspace-sync.log {
            default_type text/plain;
            add_header Cache-Control "no-store" always;
            alias /var/lib/mdv-workspace-sync/sync.log;
        }

        # Workspace data browser (workspace-sync/workspace_ui.py): browse workspace buckets and
        # open files or MDV projects in MDV without uploading them.
        location /_workspace/ {
            proxy_pass http://127.0.0.1:5057/;
            proxy_read_timeout 60s;
        }

        location ${MDV_API_ROOT} {
            # credentialless (default, not require-corp): lets no-CORS cross-origin
            # subresources (e.g. <img>/<script> against public S3/GCS buckets,
            # Ensembl, EBI without a Cross-Origin-Resource-Policy header) keep
            # loading, just without credentials attached. require-corp would
            # hard-block those. See BENCH-9901.
            # MDV's Flask app always sends COEP require-corp, and the browser enforces COEP and
            # DIP together, so COEP is replaced to match; changing DIP alone still blocks those
            # loads. MDV_ISOLATION_MODE (start.sh) selects the mode.
            proxy_hide_header Cross-Origin-Embedder-Policy;
            add_header Cross-Origin-Embedder-Policy "${MDV_COEP}" always;
            add_header Document-Isolation-Policy "isolate-and-${MDV_COEP}" always;
            # Adds the Workspace data button to MDV's pages (catalog and projects).
            sub_filter '</head>' '<script src="/_workspace/ui.js" defer></script></head>';
            sub_filter_once on;
            proxy_pass http://127.0.0.1:5056/;
        }
    }
}
