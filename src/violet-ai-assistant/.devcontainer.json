{
  "name": "Violet AI Assistant",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "shutdownAction": "none",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "postCreateCommand": [
    "./startupscript/post-startup.sh",
    "app",
    "/home/app",
    "gcp",
    "true"
  ],
  "postStartCommand": "sudo -u app /opt/llm-context/run-context-generator.sh /home/app || true; /opt/wb-mcp-server/start-server.sh || true",
  "features": {
    "ghcr.io/devcontainers/features/node@sha256:8c0de46939b61958041700ee89e3493f3b2e4131a06dc46b4d9423427d06e5f6": {
      "version": "24.11.0"
    },
    "./.devcontainer/features/gemini-cli": {
      "username": "app"
    },
    "./.devcontainer/features/workbench-tools": {
      "cloud": "gcp",
      "username": "app",
      "userHomeDir": "/home/app"
    },
    "./.devcontainer/features/postgres-client": {
      "version": "16"
    },
    "./.devcontainer/features/wb-mcp-server": {
      "username": "app",
      "userHomeDir": "/home/app"
    },
    "./.devcontainer/features/llm-context": {
      "username": "app",
      "userHomeDir": "/home/app"
    }
  }
}
