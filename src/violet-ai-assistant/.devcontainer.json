{
  "name": "Violet AI Assistant",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "shutdownAction": "none",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "postCreateCommand": [
    "./startupscript/post-startup.sh",
    "root",
    "/root",
    "gcp",
    "true"
  ],
  "postStartCommand": "/opt/wb-mcp-server/start-server.sh || true",
  "features": {
    "./.devcontainer/features/workbench-tools": {
      "cloud": "gcp",
      "username": "root",
      "userHomeDir": "/root"
    },
    "./.devcontainer/features/gemini-cli": {
      "username": "root"
    },
    "./.devcontainer/features/wb-mcp-server": {
      "username": "root",
      "userHomeDir": "/root"
    }
  }
}
