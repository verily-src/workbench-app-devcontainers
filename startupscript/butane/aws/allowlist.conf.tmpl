# PHP-187853: dnsmasq restricted-mode config, templated. dns-filter-setup.sh substitutes the
# region placeholder below with this instance's own region (read via IMDS) and appends a server=
# line for this instance's WSM environment (derived from the terra-cli-server tag via
# service-utils.sh's get_service_url, the same mapping every other script already uses for that),
# writing the result to /home/core/allowlist.conf. dns-filter.service bind-mounts that file into
# the container - this file is not baked into the dns-filter image itself.
no-resolv
listen-address=172.17.0.1
bind-interfaces
server=/s3.${REGION}.amazonaws.com/169.254.169.253
server=/s3.amazonaws.com/169.254.169.253
server=/ecr.${REGION}.amazonaws.com/169.254.169.253
server=/dkr.ecr.${REGION}.amazonaws.com/169.254.169.253
server=/codeartifact.${REGION}.amazonaws.com/169.254.169.253
server=/d.codeartifact.${REGION}.amazonaws.com/169.254.169.253
server=/ec2.${REGION}.amazonaws.com/169.254.169.253
server=/logs.${REGION}.amazonaws.com/169.254.169.253
server=/ssm.${REGION}.amazonaws.com/169.254.169.253
server=/ssmmessages.${REGION}.amazonaws.com/169.254.169.253
server=/${REGION}.rds.amazonaws.com/169.254.169.253
server=/efs.${REGION}.amazonaws.com/169.254.169.253
server=/sts.${REGION}.amazonaws.com/169.254.169.253
address=/#/
