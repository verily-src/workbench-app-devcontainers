[Unit]
Description=Apply Workbench host maintenance
Requires=workbench-update.service
After=workbench-update.service
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/workbench/maintenance.env
EnvironmentFile=/etc/workbench/app.env
ExecStart=/bin/bash /etc/workbench/maintenance/run-maintenance.sh
ExecStartPost=/bin/bash /etc/workbench/maintenance/start-host.sh
ExecStopPost=-/bin/bash /etc/workbench/maintenance/report-failure.sh /var/lib/workbench-maintenance
TimeoutStopSec=15s
TimeoutStopFailureMode=kill
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
