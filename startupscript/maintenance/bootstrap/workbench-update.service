[Unit]
Description=Update Workbench host files
Wants=network-online.target nvidia.service
After=network-online.target systemd-sysext.service nvidia.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/workbench/maintenance.env
ExecStart=/etc/workbench/maintenance/update-host.sh
ExecStopPost=-/etc/workbench/maintenance/report-failure.sh /var/lib/workbench-maintenance
TimeoutStartSec=2min
TimeoutStopSec=15s
TimeoutStopFailureMode=kill
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
